# Knowstead – example configuration
# Copy this file to `.env` and adjust it. All values are optional;
# without a `.env` file Knowstead starts with the defaults shown here.
# Content-related settings (site name, registration, SMTP, backups …)
# are not kept here but in the interface under Administration.

# --- Network ----------------------------------------------------------------
# Port of the server
PORT=3000
# Network interface (0.0.0.0 = all, 127.0.0.1 = local only)
HOST=0.0.0.0
# Public address. Used for links in e-mails, webhooks and the API documentation.
# Behind a reverse proxy enter the external https address.
BASE_URL=http://localhost:3000
# A reverse proxy (nginx, Traefik, IIS …) in front? Then enter its address, e.g. 127.0.0.1,
# 10.0.0.5 or uniquelocal (all private networks) – or `true` for any sender.
# Only then are X-Forwarded-For/Proto evaluated.
TRUST_PROXY=false
# Send the session cookie over HTTPS only: auto | true | false
# `auto`: "Secure" as soon as the request arrives via HTTPS – directly or through a reverse proxy
# that sets `X-Forwarded-Proto: https`. `true` enforces it (sign-in then works over HTTPS only).
COOKIE_SECURE=auto

# --- Data -------------------------------------------------------------------
# Directory for the database, attachments, backups and the server key.
# This directory is the only one that needs to be backed up.
DATA_DIR=data
# Different path to the SQLite file (default: DATA_DIR/knowstead.db)
#DB_FILE=data/knowstead.db
# Directory with the plugins
PLUGINS_DIR=plugins
# Built interface (npm run build)
WEB_DIST_DIR=web/dist

# --- Security ---------------------------------------------------------------
# Key for encrypted credentials (connectors, SMTP, plugins) and signatures.
# If not given, DATA_DIR/secret.key is created on first start.
# In containers without a persistent DATA_DIR be sure to set it yourself (>= 32 characters)!
#KNOWSTEAD_SECRET=please-replace-with-a-long-random-string

# --- Operation --------------------------------------------------------------
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# Additionally write the log to a file (rotated at 10 MB, five older files are kept).
# Relative to the data directory. The Windows assistant sets it for the scheduled task.
#LOG_FILE=logs/knowstead.log
# How Knowstead is run, entered by the installer: task | nssm | systemd | docker
# For display only (Administration → Next steps, system information).
#KNOWSTEAD_SERVICE=systemd
# Time zone for the nightly backup, the daily digest and dates in exports.
# If not given, the server's time zone applies (Docker: Europe/Berlin, see docker-compose.yml).
#TZ=Europe/Berlin
NODE_ENV=production
