{
  "name": "knowstead-e2e",
  "private": true,
  "type": "module",
  "description": "Oberflächentests für Knowstead (Playwright) – eigenständig, gehört nicht zur Produktivinstallation",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "sweep": "node sweep.mjs",
    "scan:english": "node english-scan.mjs",
    "scan:contrast": "node contrast-scan.mjs",
    "scan:perf": "node perf-probe.mjs",
    "shots": "node shots.mjs",
    "report": "playwright show-report reports/html",
    "typecheck": "node ../node_modules/typescript/bin/tsc -p tsconfig.json",
    "install-browser": "playwright install chromium"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0"
  }
}
